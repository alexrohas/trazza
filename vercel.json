{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd web && corepack pnpm install --frozen-lockfile",
  "buildCommand": "cd web && corepack pnpm build",
  "outputDirectory": "web/dist",
  "build": {
    "env": {
      "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0"
    }
  },
  "redirects": [
    {
      "source": "/app.html",
      "destination": "/app",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/app/index.html"
    },
    {
      "source": "/calculadora-lucid",
      "destination": "/calculadora-lucid/index.html"
    }
  ]
}
